# Copy to .env and fill in. .env is git-ignored and must never be committed (SEC-010).
# Full registry of configuration keys: MentorTaskFlow_TZ_v2.2.md, Приложение L.

# ---- Image ------------------------------------------------------------------
MTF_IMAGE=ghcr.io/shamsiddin-it/taskmanagerbackend:latest
ASPNETCORE_ENVIRONMENT=Production

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=mentortaskflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Three roles with non-overlapping privileges (TZ 12.6). The API never connects as the migrator.
CONNECTION_STRING_APP=Host=postgres;Port=5432;Database=mentortaskflow;Username=mentortaskflow_app;Password=
CONNECTION_STRING_MIGRATOR=Host=postgres;Port=5432;Database=mentortaskflow;Username=mentortaskflow_migrator;Password=

# ---- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---- Auth (Приложение L.1) --------------------------------------------------
# At least 256 bits (SEC-010). Generate with: openssl rand -base64 48
AUTH_JWT_SIGNING_KEY=

# ---- CORS (SEC-006) ---------------------------------------------------------
# Exactly the SPA origin. A wildcard is never valid — AllowCredentials forbids it.
# The domain is not assigned yet; DEPLOY-012 expects app.<domain> / api.<domain>.
CORS_ALLOWED_ORIGIN=https://app.example.com

# ---- AI summaries (Приложение L.6, TZ 22) -----------------------------------
# Optional. Left as false the installation still serves every metric of section 21; only
# POST /reports/ai-summary answers 404, and /health/ready reports AI as degraded, never Unhealthy
# (AI-018, AI-019). Turning it on requires the key — it is a secret and comes from here, never from
# a committed file (SEC-010).
AI_ENABLED=false
AI_API_KEY=
AI_MODEL_ID=claude-sonnet-5
# Bump when the prompt changes: every cached report keyed on the old version falls out of cache.
AI_PROMPT_VERSION=v1.0

# ---- Bootstrap (TZ 32.6, DEPLOY-023) ----------------------------------------
# Required on the very first start against an empty database. There is deliberately no password
# variable: the first Organization Admin receives a one-time set-password link (AUTH-019).
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ORGANIZATION_SLUG=
BOOTSTRAP_HEAD_OFFICE_NAME=
BOOTSTRAP_HEAD_OFFICE_CODE=
BOOTSTRAP_HEAD_OFFICE_TIMEZONE=Asia/Dushanbe
BOOTSTRAP_ADMIN_EMAIL=
