<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Identity">
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <!-- Must not trail what JwtBearer 10.0.10 pulls in transitively, or central pinning reports NU1109. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Microsoft.OpenApi 2.0.0 carries GHSA-v5pm-xwqc-g5wc (High), so it must be pinned away from.
      3.9.0 was the first attempt, but Swashbuckle targets the 2.x object model and fails at runtime
      with MissingMethodException on IOpenApiRequestBody.get_Content once any endpoint has a request
      body. 2.11.0 is the fixed 2.x line: same API surface, no advisory.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <!--
      The AWS SDK rather than the MinIO client: the TZ specifies "S3-compatible storage (MinIO)", and
      presigned URLs with response-header overrides — which SEC-017 needs to force
      Content-Disposition per request — are first-class here.
    -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.10" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- TEST-004: a real MinIO, not a fake. Presigned URLs and bucket policy are what is being tested. -->
    <PackageVersion Include="Testcontainers.Minio" Version="4.13.0" />
    <!--
      Transitive pin. Testcontainers 4.13.0 — the latest release — still resolves SSH.NET 2025.1.0,
      which carries GHSA-q939-rpr3-3284 (High): ScpClient.Download() writes remote-supplied paths
      without checking they stay inside the target directory. 2026.0.0 is the fixed line. The package
      reaches us only through Testcontainers' SSH-based Docker endpoint, which these tests never use —
      they talk to the local daemon — but NuGetAudit judges the graph, not the call sites, and
      lowering the threshold instead would blind us to the next advisory (SEC-014).
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
  </ItemGroup>

</Project>
