# Normalize line endings in the repository to LF; check out native on Windows.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.props     text
*.json      text
*.yml       text
*.md        text
*.sql       text

# Files consumed by Linux containers must keep LF regardless of the checkout platform.
Dockerfile  text eol=lf
*.sh        text eol=lf
