{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Database": {
    "MigrateOnStartup": false,
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Scheduler": {
    "Enabled": false,
    "EnableServer": false,
    "Schema": "hangfire",
    "OverdueIntervalMinutes": 15,
    "OverdueBatchSize": 200,
    "AutoGenerationHour": 6
  },

  "Telegram": {
    "Enabled": false,
    "BotUsername": "mentortaskflow_bot",
    "BindTokenRequestsPerHour": 5,
    "BindAttemptsPerHourPerChat": 20
  },

  "Ai": {
    "Enabled": false,
    "ModelId": "claude-sonnet-5",
    "PromptVersion": "v1.0",
    "MaxInputTokens": 12000,
    "MaxOutputTokens": 1500,
    "TimeoutSeconds": 30,
    "TotalBudgetSeconds": 90,
    "MaxRetries": 2,
    "MaxComments": 50,
    "MaxCommentChars": 500,
    "MaxTotalChars": 20000,
    "ForceRegenerationPerDay": 1
  },

  "Notifications": {
    "EnableWorker": false,
    "PollSeconds": 30,
    "LeaseSweepSeconds": 300,
    "BatchSize": 50,
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SmtpUseSsl": false,
    "FromAddress": "noreply@mentortaskflow.local",
    "FromName": "MentorTaskFlow",
    "AppBaseUrl": "http://localhost:5173"
  },

  "Storage": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "mentortaskflow",
    "UsePathStyle": true,
    "UseSsl": false,
    "EnsureBucketOnStartup": false,
    "PresignedUrlMinutes": 10,
    "MaxFileBytes": 52428800,
    "ZipMaxEntries": 2000,
    "ZipMaxUncompressedBytes": 314572800,
    "ZipMaxRatio": 100,
    "ZipValidationTimeoutSeconds": 5,
    "OrphanTtlHours": 24
  }
}
